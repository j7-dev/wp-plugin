{
	"name": "j7-dev/wp-plugin",
	"description": "This is a boilerplate for creating a WordPress plugin with vite",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-only",
	"authors": [
		{
			"name": "JerryLiu",
			"email": "j7.dev.gg@gmail.com",
			"homepage": "https://github.com/j7-dev",
			"role": "Developer"
		}
	],
	"repositories": [
		{
			"type": "composer",
			"url": "https://wpackagist.org"
		}
	],
	"autoload": {
		"psr-4": {
			"J7\\WpPlugin\\": "inc/classes/"
		}
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true,
			"phpstan/extension-installer": true
		}
	},
	"extra": {
		"strauss": {
			"target_directory": "vendor-prefixed",
			"namespace_prefix": "MyNS\\",
			"classmap_prefix": "MyNS_",
			"constant_prefix": "MyNS_",
			"include_modified_date": false,
			"delete_vendor_packages": false,
			"exclude_from_prefix": {
				"packages": [
					"yahnis-elsts/plugin-update-checker"
				]
			},
			"exclude_from_copy": {
				"file_patterns": [
					"/examples/"
				]
			}
		}
	},
	"require": {
		"j7-dev/wp-utils": "^0.3"
	},
	"require-dev": {
		"squizlabs/php_codesniffer": "@stable",
		"wp-coding-standards/wpcs": "@stable",
		"dealerdirect/phpcodesniffer-composer-installer": "@stable",
		"phpcompatibility/php-compatibility": "@stable",
		"phpstan/phpstan": "@stable",
		"php-stubs/woocommerce-stubs": "@stable",
		"php-stubs/wordpress-stubs": "@stable",
		"phpstan/extension-installer": "@stable"
	},
	"scripts": {
		"lint": "phpcs",
		"analyse": "phpstan analyse inc --memory-limit=6G",
		"strauss:clean": "php bin/strauss-clean.php",
		"strauss:run": "php bin/strauss-wrapper.php",
		"strauss": [
			"@strauss:clean",
			"@strauss:run"
		],
		"post-install-cmd": [
			"@strauss"
		],
		"post-update-cmd": [
			"@strauss"
		]
	}
}